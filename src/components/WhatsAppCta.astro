---
interface Props {
  whatsappNumber: string;
  siteName: string;
}

const { whatsappNumber, siteName } = Astro.props;
const digits = whatsappNumber.replace(/\D/g, '');
const message = `Olá, vim pelo site ${siteName} e gostaria de um atendimento.`;
const href = `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
---

{
  digits && (
    <a
      class="whatsapp-cta"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Converse conosco no WhatsApp com ${siteName}`}
    >
      <svg
        class="whatsapp-cta__icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="26"
        height="26"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.55 2 2.06 6.49 2.06 12c0 1.76.46 3.48 1.34 5L2 22l5.15-1.35A9.93 9.93 0 0 0 12.04 22c5.5 0 9.99-4.49 9.99-10 0-2.67-1.04-5.18-2.98-7.09m-7.01 15.37c-1.52 0-3.01-.4-4.31-1.17l-.31-.18-3.06.8.82-2.98-.2-.33a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.15 8.23m4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29"
        />
      </svg>
      <span>Converse conosco no Whatsapp</span>
    </a>
  )
}

<style>
  .whatsapp-cta {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    max-width: calc(100vw - (var(--space-4) * 2));
    padding: 0.85rem 1.15rem;
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: var(--shadow-md);
  }

  .whatsapp-cta:hover,
  .whatsapp-cta:focus-visible {
    filter: brightness(1.06);
  }

  .whatsapp-cta__icon {
    display: block;
    flex-shrink: 0;
  }
</style>
