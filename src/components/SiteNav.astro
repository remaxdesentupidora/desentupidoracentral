---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import brandLogo from '../assets/uploads/servicos/logo.png';

const settings = await getEntry('siteSettings', 'default');

const brandName =
  settings?.data.organization.name ??
  settings?.data.organization.legalName ??
  settings?.data.siteName ??
  'Desentupidora Central';

const whatsappHref =
  buildWhatsAppUrl(settings?.data.organization.whatsappNumber) ?? '/whatsapp';
---

<header class="site-header">
  <div class="site-topbar">
    <p class="site-topbar__msg">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1z"
        />
      </svg>
      <span>Desentupidora 24h Curitiba e Região Metropolitana. Entupiu? Fique tranquilo!</span>
    </p>
    <a
      class="site-topbar__cta"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>Cobrimos qualquer orçamento</span>
      <span class="site-topbar__wa" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16">
          <path
            fill="currentColor"
            d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.55 2 2.06 6.49 2.06 12c0 1.76.46 3.48 1.34 5L2 22l5.15-1.35A9.93 9.93 0 0 0 12.04 22c5.5 0 9.99-4.49 9.99-10 0-2.67-1.04-5.18-2.98-7.09m-7.01 15.37c-1.52 0-3.01-.4-4.31-1.17l-.31-.18-3.06.8.82-2.98-.2-.33a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.15 8.23m4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29"
          />
        </svg>
      </span>
    </a>
  </div>

  <nav class="site-nav" aria-label="Principal">
    <a class="site-nav__brand" href="/" aria-label={`${brandName} — página inicial`}>
      <Image
        src={brandLogo}
        alt={`Logotipo da ${brandName}`}
        format="webp"
        quality="mid"
        height={48}
        densities={[1, 2]}
      />
      <span>{brandName}</span>
    </a>

    <a href="/">Home</a>
    <a href="/sobre/">Sobre</a>
    <a href="/servicos/">Serviços</a>
    <a href="/locais/">Locais de Atendimento</a>
    <a href="/blog">Blog</a>
  </nav>
</header>

<style>
  .site-topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 0.55rem var(--space-4);
    background: var(--color-primary);
    color: #fff;
  }

  .site-topbar__msg {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.35;
  }

  .site-topbar__msg svg {
    flex-shrink: 0;
  }

  .site-topbar__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.28rem 0.35rem 0.28rem 0.9rem;
    background: #fff;
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    white-space: nowrap;
  }

  .site-topbar__cta:hover,
  .site-topbar__cta:focus-visible {
    color: var(--color-text);
    text-decoration: none;
    filter: brightness(0.97);
  }

  .site-topbar__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: 50%;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-right: auto;
    color: var(--color-text);
    font-weight: 700;
  }

  .site-nav__brand:hover,
  .site-nav__brand:focus-visible {
    color: var(--color-primary);
    text-decoration: none;
  }

  .site-nav__brand :global(img) {
    display: block;
    height: 3rem;
    width: auto;
  }

  :global([data-theme='classic']) .site-nav {
    justify-content: center;
  }

  .site-nav a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 767px) {
    .site-topbar {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .site-topbar__msg {
      justify-content: center;
    }

    .site-topbar__cta {
      justify-content: center;
      align-self: center;
    }
  }
</style>
