---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

interface Props {
  heading?: string;
  headingLevel?: 1 | 2;
}

const { heading, headingLevel = 2 } = Astro.props;
const HeadingTag = headingLevel === 1 ? 'h1' : 'h2';

const services = (await getCollection('services'))
  .map((service) => {
    const hero = service.data.blocks.find((block) => block.type === 'hero');
    return {
      title: service.data.title,
      slug: service.data.slug,
      excerpt: service.data.excerpt,
      image: hero?.type === 'hero' ? hero.image : undefined,
      alt: hero?.type === 'hero' ? hero.alt : undefined,
    };
  })
  .sort((left, right) => left.title.localeCompare(right.title, 'pt-BR'));
---

{
  services.length > 0 ? (
    <section class="service-grid" aria-label={heading ? undefined : 'Serviços'}>
      {heading ? <HeadingTag>{heading}</HeadingTag> : null}
      <ul class="service-grid__list">
        {services.map((service) => (
          <li>
            <a class="service-grid__card" href={`/servicos/${service.slug}/`}>
              {
                service.image ? (
                  <figure class="service-grid__media">
                    <Image
                      src={service.image}
                      alt={service.alt ?? service.title}
                      format="webp"
                      quality="mid"
                      widths={[320, 480, 720]}
                      sizes="(min-width: 960px) 22rem, (min-width: 640px) 45vw, 92vw"
                    />
                  </figure>
                ) : null
              }
              <span class="service-grid__body">
                <span class="service-grid__title">{service.title}</span>
                {service.excerpt ? <span class="service-grid__excerpt">{service.excerpt}</span> : null}
                <span class="service-grid__more">Saiba mais</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : null
}

<style>
  .service-grid {
    padding: var(--space-5) var(--space-4);
  }

  .service-grid :is(h1, h2) {
    font-family: var(--font-secondary);
    margin-bottom: var(--space-3);
    letter-spacing: var(--heading-letter-spacing);
    color: var(--color-primary);
  }

  .service-grid__list {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .service-grid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .service-grid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .service-grid__card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    background: var(--color-background);
    border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: 400;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }

  .service-grid__card:hover,
  .service-grid__card:focus-visible {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .service-grid__media {
    display: grid;
    place-items: center;
    margin: 0;
    padding: var(--space-3);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-background));
  }

  .service-grid__media :global(img) {
    display: block;
    width: auto;
    max-width: 7.5rem;
    height: 7.5rem;
    object-fit: contain;
  }

  .service-grid__body {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: 0 var(--space-3) var(--space-3);
  }

  .service-grid__title {
    display: block;
    color: var(--color-primary);
    font-weight: 700;
    line-height: 1.3;
  }

  .service-grid__card:hover .service-grid__title,
  .service-grid__card:focus-visible .service-grid__title {
    color: var(--color-accent);
  }

  .service-grid__excerpt {
    display: block;
    color: var(--color-secondary);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .service-grid__more {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 700;
  }
</style>
