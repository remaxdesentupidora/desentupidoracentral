---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/blocks/Hero.astro';
import TextBlock from '../components/blocks/TextBlock.astro';
import Gallery from '../components/blocks/Gallery.astro';
import CtaBlock from '../components/blocks/CtaBlock.astro';
import RecentArticles from '../components/blocks/RecentArticles.astro';
import FaqBlock from '../components/blocks/FaqBlock.astro';
import ServiceGrid from '../components/blocks/ServiceGrid.astro';
import LocationGrid from '../components/blocks/LocationGrid.astro';
import FeatureBanner from '../components/blocks/FeatureBanner.astro';
import PageSplit from '../components/PageSplit.astro';
import { resolveSiteUrl } from '../lib/site-url';
import { buildBreadcrumbJsonLd } from '../lib/schema-org';
import { groupContentBlocks } from '../lib/group-content-blocks';

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');

  return pages.map((entry) => ({
    params: {
      slug: entry.data.slug === 'home' ? undefined : entry.data.slug,
    },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const isHome = entry.data.slug === 'home';
const firstHeroIndex = entry.data.blocks.findIndex((block) => block.type === 'hero');
const groupedBlocks = groupContentBlocks(entry.data.blocks);
const canonicalPath = `/${entry.data.slug === 'home' ? '' : entry.data.slug}`;
const settings = await getEntry('siteSettings', 'default');
const siteUrl = resolveSiteUrl(settings?.data.siteUrl);
const breadcrumbJsonLd = isHome
  ? null
  : buildBreadcrumbJsonLd(
      [
        { name: 'Início', path: '/' },
        { name: entry.data.title, path: canonicalPath },
      ],
      siteUrl,
    );
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.metaDescription}
  ogImage={entry.data.ogImage}
  canonicalPath={canonicalPath}
>
  <SiteNav />
  <main>
    {
      isHome ? null : (
        <h1 class="page-title">{entry.data.title}</h1>
      )
    }
    {
      groupedBlocks.map((item) => {
        if (item.kind === 'text-group') {
          return (
            <PageSplit withAside={!isHome}>
              {item.blocks.map((block) =>
                block.type === 'text' ? (
                  <TextBlock
                    nested
                    layout={block.layout}
                    heading={block.heading}
                    body={block.body}
                    headingLevel={2}
                  />
                ) : null,
              )}
            </PageSplit>
          );
        }

        const { block, index } = item;

        switch (block.type) {
          case 'hero':
            return (
              <Hero
                layout={block.layout}
                badge={block.badge}
                heading={block.heading}
                subheading={block.subheading}
                image={block.image}
                alt={block.alt}
                overlayImage={block.overlayImage}
                overlayAlt={block.overlayAlt}
                checklist={block.checklist}
                cta={block.cta}
                headingLevel={isHome ? 1 : 2}
                imagePriority={isHome && index === firstHeroIndex}
              />
            );
          case 'text':
            return (
              <TextBlock
                layout={block.layout}
                heading={block.heading}
                body={block.body}
                headingLevel={2}
              />
            );
          case 'gallery':
            return <Gallery images={block.images} />;
          case 'cta':
            return (
              <CtaBlock
                heading={block.heading}
                body={block.body}
                buttonLabel={block.buttonLabel}
                buttonHref={block.buttonHref}
                headingLevel={2}
              />
            );
          case 'recentArticles':
            return <RecentArticles heading={block.heading} count={block.count} />;
          case 'faq':
            return <FaqBlock heading={block.heading} items={block.items} headingLevel={2} />;
          case 'serviceGrid':
            return <ServiceGrid heading={block.heading} headingLevel={2} />;
          case 'locationGrid':
            return (
              <LocationGrid
                heading={block.heading}
                locationType={block.locationType}
                headingLevel={2}
              />
            );
          case 'featureBanner':
            return (
              <FeatureBanner
                heading={block.heading}
                image={block.image}
                imageAlt={block.imageAlt}
                items={block.items}
                headingLevel={2}
              />
            );
          default:
            return null;
        }
      })
    }
  </main>
  {
    breadcrumbJsonLd ? (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    ) : null
  }
</BaseLayout>

<style>
  .page-title {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-4) var(--space-4) 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }
</style>
