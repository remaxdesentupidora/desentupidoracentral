---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { resolveCtaHref } from '../../lib/whatsapp';

interface Props {
  heading: string;
  subheading?: string;
  badge?: string;
  layout?: 'simple' | 'background' | 'centered';
  image?: ImageMetadata;
  alt?: string;
  overlayImage?: ImageMetadata;
  overlayAlt?: string;
  checklist?: string[];
  cta?: {
    label: string;
    href: string;
  };
  headingLevel?: 1 | 2;
  imagePriority?: boolean;
}

const {
  heading,
  subheading,
  badge,
  layout = 'simple',
  image,
  alt,
  overlayImage,
  overlayAlt,
  checklist = [],
  cta,
  headingLevel = 2,
  imagePriority = false,
} = Astro.props;
const HeadingTag = headingLevel === 1 ? 'h1' : 'h2';
const isCentered = layout === 'centered';
const isBackground = layout === 'background';
const imageLoading = isCentered || isBackground || imagePriority ? 'eager' : 'lazy';
const imageFetchPriority = isCentered || isBackground || imagePriority ? 'high' : 'auto';
const settings = await getEntry('siteSettings', 'default');
const ctaHref = resolveCtaHref(cta?.href, settings?.data.organization.whatsappNumber);

function splitHighlights(text: string) {
  return text.split(/(\*\*[^*]+\*\*)/g).filter(Boolean).map((part) => {
    const highlighted = part.startsWith('**') && part.endsWith('**');
    return {
      text: highlighted ? part.slice(2, -2) : part,
      highlight: highlighted,
    };
  });
}
---

{
  isCentered ? (
    <section class:list={['hero', 'hero--centered', !image && 'hero--no-image']}>
      <div class="hero__copy">
        {badge ? <p class="hero__badge">{badge}</p> : null}
        <HeadingTag>
          {splitHighlights(heading).map((part) => (part.highlight ? <strong>{part.text}</strong> : part.text))}
        </HeadingTag>
        {subheading ? <p class="hero__subheading">{subheading}</p> : null}
        {
          checklist.length > 0 ? (
            <ul class="hero__pills">
              {checklist.map((item) => (
                <li>
                  {splitHighlights(item).map((part) => (part.highlight ? <strong>{part.text}</strong> : part.text))}
                </li>
              ))}
            </ul>
          ) : null
        }
        {
          cta && (
            <a class="hero__cta" href={ctaHref}>
              <svg
                class="hero__cta-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="22"
                height="22"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  fill="currentColor"
                  d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.55 2 2.06 6.49 2.06 12c0 1.76.46 3.48 1.34 5L2 22l5.15-1.35A9.93 9.93 0 0 0 12.04 22c5.5 0 9.99-4.49 9.99-10 0-2.67-1.04-5.18-2.98-7.09m-7.01 15.37c-1.52 0-3.01-.4-4.31-1.17l-.31-.18-3.06.8.82-2.98-.2-.33a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.15 8.23m4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29"
                />
              </svg>
              {cta.label}
            </a>
          )
        }
      </div>
      {
        image ? (
          <figure class="hero__media">
            <Image
              src={image}
              alt={alt ?? heading}
              format="webp"
              quality="mid"
              loading={imageLoading}
              fetchpriority={imageFetchPriority}
              widths={[720, 1100, 1600]}
              sizes="(min-width: 960px) 70rem, 92vw"
            />
          </figure>
        ) : null
      }
    </section>
  ) : isBackground ? (
    <section class="hero hero--background">
      {
        image ? (
          <div class="hero__bg">
            <Image
              src={image}
              alt={alt ?? heading}
              format="webp"
              quality="mid"
              loading={imageLoading}
              fetchpriority={imageFetchPriority}
              widths={[800, 1280, 1920]}
              sizes="100vw"
            />
          </div>
        ) : null
      }
      <div class="hero__overlay" aria-hidden="true" />
      {
        overlayImage ? (
          <div class="hero__person">
            <Image
              src={overlayImage}
              alt={overlayAlt ?? ''}
              format="webp"
              quality="mid"
              loading={imageLoading}
              widths={[400, 720]}
              sizes="(min-width: 768px) 28rem, 46vw"
            />
          </div>
        ) : null
      }
      <div class="hero__inner">
        <HeadingTag>{heading}</HeadingTag>
        <div class="hero__card">
          <ul>
            {checklist.map((item) => (
              <li>
                <span class="hero__check" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" focusable="false">
                    <path fill="currentColor" d="M9.2 16.6 4.8 12.2l1.4-1.4 3 3 8.6-8.6 1.4 1.4z" />
                  </svg>
                </span>
                <span>
                  {splitHighlights(item).map((part) =>
                    part.highlight ? <strong>{part.text}</strong> : part.text,
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
        {
          cta && (
            <a class="hero__cta" href={ctaHref}>
              <svg
                class="hero__cta-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="22"
                height="22"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  fill="currentColor"
                  d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.55 2 2.06 6.49 2.06 12c0 1.76.46 3.48 1.34 5L2 22l5.15-1.35A9.93 9.93 0 0 0 12.04 22c5.5 0 9.99-4.49 9.99-10 0-2.67-1.04-5.18-2.98-7.09m-7.01 15.37c-1.52 0-3.01-.4-4.31-1.17l-.31-.18-3.06.8.82-2.98-.2-.33a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.15 8.23m4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29"
                />
              </svg>
              {cta.label}
            </a>
          )
        }
      </div>
    </section>
  ) : (
    <section class:list={['hero', 'hero--simple', !image && 'hero--no-image']}>
      {
        image ? (
          <figure class="hero__emblem">
            <Image
              src={image}
              alt={alt ?? heading}
              format="webp"
              quality="mid"
              loading={imageLoading}
              fetchpriority={imageFetchPriority}
              widths={[image.width]}
              sizes={`${image.width}px`}
            />
          </figure>
        ) : null
      }
      <div class="hero__content">
        <HeadingTag>{heading}</HeadingTag>
        {subheading && <p class="hero__subheading">{subheading}</p>}
        {
          cta && (
            <a class="hero__cta" href={ctaHref}>
              {cta.label}
            </a>
          )
        }
      </div>
    </section>
  )
}

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
    align-items: center;
  }

  .hero--simple {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .hero--simple .hero__content {
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .hero--simple:not(.hero--no-image) {
      flex-direction: row;
      align-items: center;
      gap: var(--space-4);
    }
  }

  .hero__content :is(h1, h2) {
    font-family: var(--font-secondary);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--color-primary);
  }

  .hero__subheading {
    margin-top: var(--space-2);
    color: var(--color-secondary);
    font-size: 1.125rem;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: var(--space-3);
    padding: 0.75rem 1.25rem;
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    filter: brightness(1.08);
  }

  .hero__cta-icon {
    display: block;
    flex-shrink: 0;
  }

  .hero__media :global(img) {
    height: auto;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  .hero__emblem {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 7.5rem;
    height: 7.5rem;
    flex-shrink: 0;
    margin: 0;
    padding: 0.7rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-background));
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  .hero__emblem :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero--background {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 86vh;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg :global(img),
  .hero__bg :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__bg :global(img) {
    position: absolute;
    inset: 0;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(8, 12, 16, 0.62) 0%,
      rgba(8, 12, 16, 0.42) 42%,
      rgba(8, 12, 16, 0.18) 68%,
      rgba(8, 12, 16, 0.06) 100%
    );
  }

  .hero__person {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    height: 100%;
    width: min(42vw, 28rem);
    pointer-events: none;
  }

  .hero__person :global(img),
  .hero__person :global(picture) {
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: right bottom;
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(40rem, 100%);
    margin-left: clamp(var(--space-4), 7vw, 5.5rem);
    margin-right: auto;
    padding: var(--space-6) var(--space-4);
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero__inner {
      padding-block: var(--space-6);
      padding-right: 0;
    }
  }

  @media (max-width: 767px) {
    .hero--background {
      min-height: 78vh;
    }

    .hero__inner {
      margin-inline: auto;
    }

    .hero__bg :global(img) {
      object-position: center;
    }

    .hero__person {
      width: 46%;
    }
  }

  .hero--background .hero__inner :is(h1, h2) {
    max-width: 18ch;
    color: #fff;
    font-family: var(--font-primary);
    font-size: clamp(1.85rem, 4.6vw, 3.15rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .hero--background .hero__cta {
    margin-top: var(--space-3);
    padding: 0.95rem 1.7rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero__card {
    width: min(28rem, 100%);
    margin-top: var(--space-4);
    background: var(--color-background);
    color: var(--color-text);
    border-radius: 2.25rem;
    box-shadow: var(--shadow-md);
    padding: var(--space-4) var(--space-4);
  }

  .hero__card ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hero__card li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-secondary);
  }

  .hero__card strong {
    color: #1aa3a8;
    font-weight: 700;
  }

  .hero__check {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .hero--centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: var(--space-6) var(--space-4) 0;
    text-align: center;
  }

  .hero--centered.hero--no-image {
    padding-bottom: var(--space-6);
  }

  .hero--centered .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(46rem, 100%);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    margin-bottom: var(--space-3);
    padding: 0.35rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    border-radius: 999px;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .hero--centered :is(h1, h2) {
    font-family: var(--font-secondary);
    font-size: clamp(1.9rem, 4.4vw, 3.15rem);
    line-height: 1.15;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--color-primary);
  }

  .hero--centered :is(h1, h2) strong {
    color: var(--color-accent);
    font-weight: 700;
  }

  .hero--centered .hero__subheading {
    max-width: 38rem;
    margin-top: var(--space-2);
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  .hero__pills li {
    padding: 0.4rem 0.85rem;
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-background));
    color: var(--color-text);
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .hero__pills strong {
    color: var(--color-accent);
    font-weight: 700;
  }

  .hero--centered .hero__cta {
    margin-top: var(--space-4);
    padding: 0.95rem 1.7rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .hero--centered .hero__media {
    position: relative;
    z-index: 2;
    width: min(72rem, 100%);
    margin: var(--space-5) 0 -2rem;
    transform: translateY(-0.25rem);
  }

  .hero--centered .hero__media :global(img) {
    display: block;
    width: min(36rem, 100%);
    max-height: 34rem;
    height: auto;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    object-fit: contain;
    object-position: center bottom;
  }
</style>
