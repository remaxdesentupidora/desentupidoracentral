---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  heading?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  items: string[];
  headingLevel?: 1 | 2;
}

const { heading, image, imageAlt, items, headingLevel = 2 } = Astro.props;
const HeadingTag = headingLevel === 1 ? 'h1' : 'h2';
const headingMatch = heading?.match(/^(?<lead>\S+)(?<space>\s+)(?<rest>[\s\S]+)$/);
const headingLead = headingMatch?.groups?.lead;
const headingSpace = headingMatch?.groups?.space ?? '';
const headingRest = headingMatch?.groups?.rest;
---

<section class:list={['feature-banner', !image && 'feature-banner--no-image']}>
  {
    image ? (
      <figure class="feature-banner__media">
        <Image
          src={image}
          alt={imageAlt ?? heading ?? 'Destaques do atendimento'}
          format="webp"
          quality="mid"
          loading="lazy"
        />
      </figure>
    ) : null
  }
  <div class="feature-banner__content">
    <span class="feature-banner__chevrons" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 72 24" width="72" height="24" focusable="false">
        <path fill="currentColor" d="M8 4 18 12 8 20l-2.2-2.2L13.6 12 5.8 6.2 8 4zm16 0 10 8-10 8-2.2-2.2L29.6 12l-7.8-5.8L24 4zm16 0 10 8-10 8-2.2-2.2L45.6 12l-7.8-5.8L40 4z" />
      </svg>
    </span>
    {
      heading ? (
        headingLead && headingRest ? (
          <HeadingTag class="feature-banner__heading">
            <span class="feature-banner__lead">{headingLead}</span>
            {headingSpace}
            <span class="feature-banner__rest">{headingRest}</span>
          </HeadingTag>
        ) : (
          <HeadingTag class="feature-banner__heading">{heading}</HeadingTag>
        )
      ) : null
    }
    <ul class="feature-banner__list">
      {
        items.map((item) => (
          <li>
            <span class="feature-banner__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="4" fill="currentColor" opacity="0.18" />
                <path fill="currentColor" d="M10.2 16.2 6.4 12.4l1.4-1.4 2.4 2.4 5.8-5.8 1.4 1.4z" />
              </svg>
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feature-banner {
    display: grid;
    gap: var(--space-4);
    width: min(var(--page-max), calc(100% - (var(--space-4) * 2)));
    margin: var(--space-5) auto;
    padding: var(--space-5) var(--space-4);
    align-items: center;
    background:
      radial-gradient(circle at 18% 20%, color-mix(in srgb, #fff 16%, transparent), transparent 42%),
      linear-gradient(180deg, color-mix(in srgb, #000 12%, var(--color-primary)), var(--color-primary));
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .feature-banner:not(.feature-banner--no-image) {
      grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 1.1fr);
      padding: var(--space-5) var(--space-5) var(--space-5) var(--space-3);
    }
  }

  .feature-banner__content {
    position: relative;
  }

  .feature-banner__chevrons {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    color: var(--color-highlight);
  }

  @media (min-width: 768px) {
    .feature-banner__chevrons {
      display: block;
    }
  }

  .feature-banner__heading {
    display: grid;
    gap: 0.2rem;
    margin-bottom: var(--space-3);
    color: #fff;
    font-family: var(--font-primary);
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }

  .feature-banner__lead {
    font-size: clamp(1.75rem, 4vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
  }

  .feature-banner__rest {
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .feature-banner__list {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .feature-banner__list li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.7rem 1rem;
    background: var(--color-highlight);
    color: var(--color-text);
    font-weight: 600;
    border-radius: 999px;
  }

  .feature-banner__icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-text);
  }

  .feature-banner__media {
    margin: 0;
    justify-self: center;
  }

  .feature-banner__media :global(img) {
    display: block;
    width: min(22rem, 100%);
    height: auto;
    object-fit: contain;
  }
</style>
