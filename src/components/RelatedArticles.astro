---
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;
---

{
  articles.length > 0 ? (
    <section class="related-articles" aria-labelledby="related-articles-heading">
      <h2 id="related-articles-heading">Artigos relacionados</h2>
      <ul class="related-articles__list">
        {articles.map((article) => (
          <li>
            <a class="related-articles__card" href={`/blog/${article.data.slug}/`}>
              <span class="related-articles__title">{article.data.title}</span>
              {article.data.excerpt ? <span class="related-articles__excerpt">{article.data.excerpt}</span> : null}
              <span class="related-articles__more">Ler artigo</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : null
}

<style>
  .related-articles {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-5) var(--space-4);
  }

  .related-articles h2 {
    font-family: var(--font-secondary);
    margin-bottom: var(--space-3);
    letter-spacing: var(--heading-letter-spacing);
    color: var(--color-primary);
  }

  .related-articles__list {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 768px) {
    .related-articles__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .related-articles__card {
    display: grid;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    border-radius: var(--radius-md);
    background: var(--color-background);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
  }

  .related-articles__card:hover,
  .related-articles__card:focus-visible {
    border-color: var(--color-accent);
  }

  .related-articles__title {
    font-weight: 700;
    color: var(--color-primary);
  }

  .related-articles__card:hover .related-articles__title,
  .related-articles__card:focus-visible .related-articles__title {
    color: var(--color-accent);
  }

  .related-articles__excerpt {
    color: var(--color-secondary);
    line-height: 1.55;
  }

  .related-articles__more {
    margin-top: var(--space-1);
    font-weight: 600;
    color: var(--color-accent);
  }
</style>
