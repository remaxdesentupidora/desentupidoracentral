---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import SiteNav from '../../components/SiteNav.astro';

const articles = (await getCollection('articles')).sort(
  (left, right) => right.data.publishedDate.valueOf() - left.data.publishedDate.valueOf(),
);
---

<BaseLayout title="Blog" description="Últimos artigos" canonicalPath="/blog">
  <SiteNav />
  <main class="blog-index">
    <h1>Blog</h1>
    <p class="blog-index__intro">Últimos artigos</p>
    {
      articles.length > 0 ? (
        <ul class="blog-index__list">
          {articles.map((article) => (
            <li>
              <article class="blog-card">
                <a href={`/blog/${article.data.slug}`}>
                  <figure class="blog-card__cover">
                    <Image
                      src={article.data.featuredImage.src}
                      alt={article.data.featuredImage.alt}
                      format="webp"
                      quality="mid"
                      loading="lazy"
                      widths={[400, 720]}
                      sizes="(min-width: 960px) 30vw, (min-width: 640px) 45vw, 100vw"
                    />
                    {
                      article.data.featuredImage.credit ? (
                        <figcaption class="blog-card__credit">{article.data.featuredImage.credit}</figcaption>
                      ) : null
                    }
                  </figure>
                  <h2>{article.data.title}</h2>
                </a>
                <p>{article.data.excerpt}</p>
                <time datetime={article.data.publishedDate.toISOString()}>
                  {article.data.publishedDate.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
                </time>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p>Nenhum artigo publicado ainda.</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .blog-index {
    padding: var(--space-5) var(--space-4);
    max-width: 72rem;
    margin-inline: auto;
  }

  .blog-index h1 {
    font-family: var(--font-secondary);
    color: var(--color-primary);
  }

  .blog-index__intro {
    margin: var(--space-1) 0 var(--space-4);
    color: var(--color-secondary);
  }

  .blog-index__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .blog-index__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .blog-index__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .blog-card {
    height: 100%;
  }

  .blog-card a {
    color: inherit;
    text-decoration: none;
  }

  .blog-card h2 {
    margin-top: var(--space-2);
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--color-primary);
  }

  .blog-card a:hover h2,
  .blog-card a:focus-visible h2 {
    color: var(--color-accent);
  }

  .blog-card p {
    margin-top: var(--space-1);
    color: var(--color-secondary);
  }

  .blog-card time {
    display: inline-block;
    margin-top: var(--space-1);
    font-size: 0.875rem;
    color: var(--color-secondary);
  }

  .blog-card__cover {
    margin: 0;
  }

  .blog-card :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  .blog-card__credit {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-secondary);
  }
</style>
